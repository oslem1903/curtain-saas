+/**
+ * PERDEPRO İNDİRME VE DENEME BAĞLANTILARI — TEK MERKEZ
+ * -------------------------------------------------------------
+ * Windows kurulum paketi her sürümde BURADAN güncellenir (sürüm, bağlantı,
+ * SHA-256). Bağlantı gerçek bir yayın varlığına gitmeli ve SHA-256 yayınlanan
+ * dosyayla birebir aynı olmalıdır; doğrulanmadan değiştirilmez.
+ *
+ * Mağaza bağlantıları (App Store / Google Play) mağazada HERKESE AÇIK yayın
+ * doğrulanana kadar burada TANIMLANMAZ; sitede "Çok Yakında" görünür.
+ */
+export const perdeproWindows = {
+  version: "1.0.15",
+  fileName: "PerdePRO-Setup-1.0.15.exe",
+  href: "https://github.com/oslem1903/curtain-saas/releases/download/v1.0.15-windows/PerdePRO-Setup-1.0.15.exe",
+  sha256: "047721614781E5AC446DAA30537FF85E2D7710C4E65D9EC423AA5C74FF9485D9",
+  sizeLabel: "yaklaşık 148 MB",
+} as const;
+
+/** PerdePRO web uygulaması (kayıt ve giriş). Windows uygulamasıyla aynı hesap ve veriler. */
+export const perdeproWebApp = "https://oslem1903-curtain-saas.vercel.app";
+export const perdeproTrialUrl = `${perdeproWebApp}/#/signup`;
+export const perdeproLoginUrl = `${perdeproWebApp}/#/login`;
+
+/** Mağazada herkese açık yayın doğrulanınca doldurulur; boşken "Çok Yakında" gösterilir. */
+export const perdeproStoreLinks = { ios: "", android: "" } as { ios: string; android: string };
