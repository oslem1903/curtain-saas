+  icon: React.ReactNode;
+  title: string;
+  text: string;
+  live: boolean;
+}) {
+  return (
+    <div className={`${cardBase} border-navy-100 bg-white`}>
+      <div className="flex items-center justify-between text-navy-400">
+        {icon}
+        <Badge tone="soon">{live ? "Yayında" : "Çok Yakında"}</Badge>
+      </div>
+      <h3 className="mt-5 text-lg font-semibold text-navy-900">{title}</h3>
