+        className="mt-auto inline-flex cursor-not-allowed items-center justify-center rounded-full border border-navy-100 bg-navy-50 px-6 py-3 text-sm font-semibold text-navy-400"
+      >
+        Çok Yakında
+      </span>
+    </div>
+  );
+}
+
+export default function PlatformDownloads() {
+  return (
+    <section id="indir" className="border-b border-navy-100 bg-paper">
+      <Container>
+        <div className="py-16 sm:py-20">
+          <SectionHeading
+            eyebrow="Windows, iOS ve Android"
+            title="PerdePRO’yu cihazınıza indirin"
+            description="Aynı hesapla Windows, telefon ve tablette çalışın. Giriş, davet kodu veya onay beklemeden indirip kurabilirsiniz."
+          />
+
+          <div className="mt-10 grid gap-5 lg:grid-cols-3 lg:gap-6">
+            {/* WINDOWS — aktif */}
+            <div className={`${cardBase} border-navy-950 bg-navy-950 text-white`}>
+              <div className="flex items-center justify-between">
+                <span className="text-brand-400">
+                  <WindowsIcon />
+                </span>
+                <Badge tone="brand">Hazır</Badge>
+              </div>
+              <h3 className="mt-5 text-lg font-semibold">Windows</h3>
+              <p className="mt-2 text-sm leading-relaxed text-navy-200">
+                Windows 10 / 11 için masaüstü uygulaması. Sürüm {perdeproWindows.version},{" "}
+                {perdeproWindows.sizeLabel}.
+              </p>
+              <div className="mt-6 flex flex-col gap-3">
+                <a
+                  href={perdeproWindows.href}
+                  rel="noopener"
+                  className="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-brand-600"
+                >
+                  Windows için İndir
+                </a>
+                <a
+                  href={perdeproTrialUrl}
+                  rel="noopener"
+                  className="inline-flex items-center justify-center gap-2 rounded-full border border-navy-600 px-6 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:border-navy-400"
+                >
+                  7 Gün Ücretsiz Dene
+                </a>
+              </div>
+              <details className="mt-5 text-xs text-navy-300">
+                <summary className="cursor-pointer font-medium text-navy-200">
+                  Dosya doğrulama bilgisi
+                </summary>
+                <p className="mt-2 break-all">
+                  {perdeproWindows.fileName}
+                  <br />
+                  SHA-256: {perdeproWindows.sha256}
+                </p>
+                <p className="mt-2">
+                  Kurulum paketi henüz kod imzalı değildir; Windows “Bilinmeyen yayıncı” uyarısı
+                  gösterebilir. İndirdiğiniz dosyanın SHA-256 değerini yukarıdakiyle
+                  karşılaştırabilirsiniz.
+                </p>
+              </details>
+            </div>
+
+            <SoonCard
+              icon={<PhoneIcon />}
+              title="iOS"
+              text="iPhone ve iPad için uygulama App Store’da çok yakında."
+              live={Boolean(perdeproStoreLinks.ios)}
+            />
+            <SoonCard
+              icon={<TabletIcon />}
+              title="Android"
+              text="Android telefon ve tabletler için uygulama Google Play’de çok yakında."
+              live={Boolean(perdeproStoreLinks.android)}
+            />
+          </div>
+
+          <p className="mt-8 max-w-3xl text-base leading-relaxed text-navy-600">
+            iOS ve Android uygulamalarımız çok yakında App Store ve Google Play’de. Aynı hesabınızla
+            Windows, telefon ve tablet üzerinden çalışın; müşterileriniz, ölçüleriniz, teklifleriniz
+            ve siparişleriniz cihazlarınız arasında senkronize olsun.
+          </p>
+          <p className="mt-3 max-w-3xl text-sm text-navy-500">
+            Senkronizasyon internet bağlantısı gerektirir. 7 günlük deneme ve satın alınan lisans
+            firmanıza aittir; cihaz değiştirdiğinizde deneme yeniden başlamaz, ayrıca lisans gerekmez
+            (cihaz sınırları geçerlidir).
+          </p>
+        </div>
+      </Container>
+    </section>
+  );
+}
